# Shared raw result for mixed-material dynamics and neutron/QENS analysis.
# Supply labels in ascending trajectory type-ID order. This Si/O example must
# be changed to match your trajectory; it does not restrict supported species.
method = dsf
action = compute
experiment = number
atom_types = Si O
trajectory_file = scattering.xyz
out_files_name = scattering_raw
time_step = 1
output_data_stride = 10
num_blocks = 4
dsf_q_mode = spherical
dsf_q_min = 0.1
dsf_q_max = 3
dsf_q_bin_width = 0.05
dsf_max_points_per_shell = 100
dsf_currents = 1
dsf_partials = 1
# Retain elastic/quasielastic signal. Choose long enough blocks to resolve
# the intended experimental energy width; finite windows also broaden peaks.
dsf_subtract_mean = 0
dsf_window = none
